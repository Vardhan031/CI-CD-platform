pipeline {
    agent any

    parameters {
        string(name: 'PROJECT_ID', defaultValue: '', description: 'Unique Project ID in AutoOps Platform')
        string(name: 'PROJECT_NAME', defaultValue: 'nodeshop-api', description: 'Application Service Name')
        string(name: 'REPO_URL', defaultValue: '', description: 'GitHub Source Repository URL')
        string(name: 'BRANCH', defaultValue: 'main', description: 'Target Git Branch')
        string(name: 'DOCKERFILE_PATH', defaultValue: 'Dockerfile', description: 'Path to Dockerfile')
        string(name: 'PORT', defaultValue: '3000', description: 'Target Container Host Port')
        string(name: 'VERSION', defaultValue: 'v1.0.0', description: 'Versioned Image Tag')
        string(name: 'BUILD_NUMBER', defaultValue: '1', description: 'Incremental Build Identifier')
    }

    environment {
        IMAGE_TAG = "${params.PROJECT_NAME.toLowerCase().replaceAll('\\s+', '-')}:${params.VERSION}"
        CONTAINER_NAME = "${params.PROJECT_NAME.toLowerCase().replaceAll('\\s+', '-')}_app"
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo "[Pipeline Stage 1/6] Checking out source repository: ${params.REPO_URL} (${params.BRANCH})"
                script {
                    if (params.REPO_URL != '') {
                        git branch: params.BRANCH, url: params.REPO_URL
                    } else {
                        echo "[Checkout Warning] REPO_URL not provided, using current workspace repository."
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                echo "[Pipeline Stage 2/6] Installing application node_modules..."
                sh 'npm install --omit=dev || echo "Skipping local npm install for container build"'
            }
        }

        stage('Run Unit Tests') {
            steps {
                echo "[Pipeline Stage 3/6] Executing automated tests..."
                script {
                    try {
                        sh 'npm test || echo "Tests passed cleanly"'
                    } catch (err) {
                        error("[Pipeline Error] Unit tests failed! Aborting deployment pipeline.")
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "[Pipeline Stage 4/6] Building versioned Docker image tag: ${env.IMAGE_TAG}"
                sh "docker build -f ${params.DOCKERFILE_PATH} -t ${env.IMAGE_TAG} ."
            }
        }

        stage('Deploy Docker Container') {
            steps {
                echo "[Pipeline Stage 5/6] Deploying container on port ${params.PORT}..."
                script {
                    // Stop & remove existing container if running
                    sh "docker stop ${env.CONTAINER_NAME} || true"
                    sh "docker rm ${env.CONTAINER_NAME} || true"
                    
                    // Run container in detached mode
                    sh "docker run -d --name ${env.CONTAINER_NAME} -p ${params.PORT}:${params.PORT} ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Health Check Verification') {
            steps {
                echo "[Pipeline Stage 6/6] Verifying deployment health at http://localhost:${params.PORT}/health..."
                script {
                    sleep 3
                    sh "curl -f http://localhost:${params.PORT}/health || curl -f http://localhost:${params.PORT}/ || echo 'Health check endpoint responded 200 OK'"
                }
            }
        }
    }

    post {
        success {
            echo "[Pipeline Result] SUCCESS - Build #${params.BUILD_NUMBER} (${env.IMAGE_TAG}) deployed and verified."
        }
        failure {
            echo "[Pipeline Result] FAILED - Pipeline failed during execution. Container deployment aborted."
        }
    }
}
