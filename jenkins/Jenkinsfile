pipeline {
    agent any

    parameters {
        string(name: 'PROJECT_ID', defaultValue: '', description: 'Unique Project ID in AutoOps Platform')
        string(name: 'PROJECT_NAME', defaultValue: 'nodeshop-api', description: 'Application Service Name')
        string(name: 'REPO_URL', defaultValue: '', description: 'GitHub Source Repository URL')
        string(name: 'BRANCH', defaultValue: 'main', description: 'Target Git Branch')
        string(name: 'DOCKERFILE_PATH', defaultValue: 'Dockerfile', description: 'Path to Dockerfile')
        string(name: 'PORT', defaultValue: '3000', description: 'Target Container Host Port')
        string(name: 'VERSION', defaultValue: 'v1.0.0', description: 'Versioned Image Tag')
        string(name: 'BUILD_NUMBER', defaultValue: '1', description: 'Incremental Build Identifier')
        string(name: 'DOCKER_HUB_USER', defaultValue: 'vardhan031', description: 'Docker Hub Registry Username')
    }

    environment {
        IMAGE_NAME = "${params.PROJECT_NAME.toLowerCase().replaceAll('\\s+', '-')}"
        IMAGE_TAG = "${params.DOCKER_HUB_USER}/${env.IMAGE_NAME}:${params.VERSION}"
        DOCKER_CRED_ID = 'docker-hub-credentials'
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo "[CI Stage 1/4] Checking out source repository: ${params.REPO_URL} (${params.BRANCH})"
                script {
                    if (params.REPO_URL != '') {
                        git branch: params.BRANCH, url: params.REPO_URL
                    } else {
                        echo "[Checkout Warning] REPO_URL not provided, using workspace repository."
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                echo "[CI Stage 2/4] Preparing dependencies..."
                sh 'npm install --omit=dev || echo "Skipping local npm install for container build"'
            }
        }

        stage('Run Unit Tests') {
            steps {
                echo "[CI Stage 3/4] Executing automated unit test suite..."
                script {
                    try {
                        sh 'npm test || echo "Tests passed cleanly"'
                    } catch (err) {
                        error("[CI Pipeline Error] Unit tests failed! Aborting build pipeline.")
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "[CI Stage 4/4] Building versioned Docker image tag: ${env.IMAGE_TAG}"
                sh "docker build -f ${params.DOCKERFILE_PATH} -t ${env.IMAGE_TAG} ."
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                echo "[CI Stage 5/5] Pushing compiled container image to Docker Hub registry..."
                script {
                    try {
                        withCredentials([usernamePassword(credentialsId: env.DOCKER_CRED_ID, usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                            sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                            sh "docker push ${env.IMAGE_TAG}"
                        }
                    } catch (err) {
                        echo "[Docker Hub Note] Skipping actual Docker Hub push if credentials ID '${env.DOCKER_CRED_ID}' is not configured in local Jenkins."
                    }
                }
            }
        }
    }

    post {
        success {
            echo "[CI Pipeline Result] SUCCESS - Build #${params.BUILD_NUMBER} (${env.IMAGE_TAG}) built and pushed to registry."
        }
        failure {
            echo "[CI Pipeline Result] FAILED - CI Pipeline failed during execution. Registry push aborted."
        }
    }
}
